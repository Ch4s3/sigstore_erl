%% sigstore_erl — no runtime dependencies beyond OTP.
{minimum_otp_vsn, "25"}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    warn_export_vars,
    warn_unused_import,
    warn_missing_spec_documented
]}.

{deps, []}.

{escript_main_app, sigstore_erl}.
{escript_name, sigstore_conformance}.
{escript_emu_args, "%%! -escript main sigstore_conformance +sbtu +A1\n"}.

{ct_opts, [{dir, "test"}, {logdir, "_build/test/logs"}]}.
{cover_enabled, true}.
{cover_opts, [verbose]}.

{dialyzer, [
    {warnings, [unknown, unmatched_returns, error_handling]},
    {plt_apps, top_level_deps},
    {plt_extra_apps, [crypto, public_key, asn1, ssl, inets]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{project_plugins, [erlfmt]}.
{erlfmt, [write, {files, ["{src,test,include}/**/*.{erl,hrl,app.src}", "rebar.config"]}]}.

{profiles, [
    {test, [{erl_opts, [nowarn_missing_spec_documented, nowarn_export_all]}]}
]}.

{hex, [{doc, #{provider => ex_doc}}]}.
